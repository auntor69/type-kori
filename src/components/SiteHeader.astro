---
import { languageLabel, localizePath, mirrorPath, useTranslations, type Lang } from "../i18n";
import Logo from "./Logo.astro";
import SiteControls from "./SiteControls.tsx";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const lessonsPath = localizePath("/lessons", lang);
const progressPath = localizePath("/progress", lang);
const home = localizePath("/", lang);
const otherLang: Lang = lang === "bn" ? "en" : "bn";
const mirror = mirrorPath(Astro.url.pathname, otherLang);

const iconClass =
  "inline-flex size-9 items-center justify-center rounded-control text-muted transition-colors duration-150 ease-out hover:bg-surface-2 hover:text-text";
---

<!-- Monkeytype-style bar: logo left, icon buttons right. No text links, no border. -->
<header class="sticky top-0 z-30 bg-bg" style="padding-top: env(safe-area-inset-top)">
  <div class="mx-auto flex h-14 w-full max-w-[960px] items-center gap-2 px-4 sm:px-6">
    <a href={home} class="rounded-control" aria-label={`${t("nav.home")} — Type Kori`}>
      <Logo />
    </a>

    <div class="ms-auto flex items-center gap-0.5">
      <a
        href={lessonsPath}
        class={iconClass}
        aria-label={t("nav.lessons")}
        title={t("nav.lessons")}
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V4a2 2 0 0 0-2-2H6.5A2.5 2.5 0 0 0 4 4.5v15Z"
          />
          <path d="M4 19.5A2.5 2.5 0 0 0 6.5 22H20v-5" />
        </svg>
      </a>

      <a
        href={progressPath}
        class={iconClass}
        aria-label={t("nav.progress")}
        title={t("nav.progress")}
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M3 3v18h18" />
          <path d="m7 14 4-4 3 3 5-6" />
        </svg>
      </a>

      <a
        href={mirror}
        hreflang={otherLang}
        lang={otherLang}
        class={iconClass}
        aria-label={`${t("a11y.languageSwitch")}: ${languageLabel(otherLang)}`}
        title={languageLabel(otherLang)}
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="9" />
          <path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18" />
        </svg>
      </a>

      <SiteControls client:load lang={lang} />
    </div>
  </div>
</header>
