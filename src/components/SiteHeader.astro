---
import { languageLabel, localizePath, mirrorPath, useTranslations, type Lang } from "../i18n";
import Logo from "./Logo.astro";
import SiteControls from "./SiteControls.tsx";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const home = localizePath("/", lang);
const privacy = localizePath("/privacy", lang);
const otherLang: Lang = lang === "bn" ? "en" : "bn";
const mirror = mirrorPath(Astro.url.pathname, otherLang);

const links = [
  { href: `${home}#practice`, label: t("nav.practice") },
  { href: `${home}#how`, label: t("nav.how") },
  { href: privacy, label: t("nav.privacy") },
];
---

<header
  class="sticky top-0 z-30 border-b border-border/80 bg-bg/85 backdrop-blur-md"
  style="padding-top: env(safe-area-inset-top)"
>
  <div class="mx-auto flex h-16 w-full max-w-[960px] items-center gap-4 px-4 sm:px-6">
    <a href={home} class="rounded-control" aria-label={`${t("nav.home")} — Type Kori`}>
      <Logo />
    </a>

    <nav class="ms-auto hidden items-center gap-1 sm:flex" aria-label={t("nav.practice")}>
      {
        links.map((link) => (
          <a
            href={link.href}
            class="rounded-control px-3 py-2 text-sm font-medium text-muted transition-colors duration-150 ease-out hover:bg-surface-2 hover:text-text"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="ms-auto flex items-center gap-1 sm:ms-0">
      <a
        href={mirror}
        hreflang={otherLang}
        lang={otherLang}
        class="rounded-control px-2.5 py-2 text-sm font-medium text-muted transition-colors duration-150 ease-out hover:bg-surface-2 hover:text-text"
        aria-label={`${t("a11y.languageSwitch")}: ${languageLabel(otherLang)}`}
      >
        {languageLabel(otherLang)}
      </a>

      <SiteControls client:load lang={lang} />
    </div>
  </div>
</header>
