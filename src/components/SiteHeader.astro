---
import { languageLabel, localizePath, mirrorPath, useTranslations, type Lang } from "../i18n";
import CommandBar from "./CommandBar.tsx";
import Logo from "./Logo.astro";
import SiteControls from "./SiteControls.tsx";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const lessonsPath = localizePath("/lessons", lang);
const progressPath = localizePath("/progress", lang);
const home = localizePath("/", lang);
const otherLang: Lang = lang === "bn" ? "en" : "bn";
const mirror = mirrorPath(Astro.url.pathname, otherLang);

const iconClass =
  "inline-flex size-9 items-center justify-center rounded-control text-muted transition-colors duration-150 ease-out hover:bg-surface-2 hover:text-text";

// One line of glue for the theme quick picker: forward the click to the
// settings drawer island. The event name is shared with applySettings.ts; it is
// spelled out here because this script must run before any island hydrates.
const themePickerGlue = `
  document.addEventListener("click", function (event) {
    var button = event.target instanceof Element ? event.target.closest("[data-tk-theme-button]") : null;
    if (button) window.dispatchEvent(new CustomEvent("tk:open-theme-picker"));
  });
`;
---

<!-- Monkeytype-style bar: logo left, icon buttons right. No text links, no border.
     Marked as chrome so focus mode can fade it away while a test is running. -->
<header class="sticky top-0 z-30 bg-bg" data-tk-chrome style="padding-top: env(safe-area-inset-top)">
  <div class="flex h-14 w-full items-center gap-2 px-4 sm:px-6">
    <a href={home} class="rounded-control" aria-label={`${t("nav.home")} — Type Kori`}>
      <Logo />
    </a>

    <div class="ms-auto flex items-center gap-0.5">
      <nav aria-label={t("nav.primary")} class="flex items-center gap-0.5">
      <a
        href={lessonsPath}
        class={iconClass}
        aria-label={t("nav.lessons")}
        title={t("nav.lessons")}
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V4a2 2 0 0 0-2-2H6.5A2.5 2.5 0 0 0 4 4.5v15Z"
          />
          <path d="M4 19.5A2.5 2.5 0 0 0 6.5 22H20v-5" />
        </svg>
      </a>

      <a
        href={progressPath}
        class={iconClass}
        aria-label={t("nav.progress")}
        title={t("nav.progress")}
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M3 3v18h18" />
          <path d="m7 14 4-4 3 3 5-6" />
        </svg>
      </a>

      <a
        href={mirror}
        hreflang={otherLang}
        lang={otherLang}
        class={iconClass}
        aria-label={`${t("a11y.languageSwitch")}: ${languageLabel(otherLang)}`}
        title={languageLabel(otherLang)}
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="9" />
          <path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18" />
        </svg>
      </a>

      {/* Theme quick picker: the small palette icon, monkeytype's footer "dev"
          equivalent. It asks the settings drawer island to open on its theme
          tab; before that island hydrates the click simply does nothing. */}
      <button
        type="button"
        class={iconClass}
        aria-label={t("nav.theme")}
        title={t("nav.theme")}
        data-tk-theme-button
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="13.5" cy="6.5" r=".5" fill="currentColor" />
          <circle cx="17.5" cy="10.5" r=".5" fill="currentColor" />
          <circle cx="8.5" cy="7.5" r=".5" fill="currentColor" />
          <circle cx="6.5" cy="12.5" r=".5" fill="currentColor" />
          <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"
          />
        </svg>
      </button>

      <CommandBar client:load lang={lang} />
      <SiteControls client:load lang={lang} />
      </nav>
    </div>
  </div>
</header>

<script is:inline set:html={themePickerGlue} />
