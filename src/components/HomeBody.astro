---
import Practice from "./Practice.tsx";
import { homeCopy } from "../content/home";
import type { Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = homeCopy[lang];
---

<!-- The page is the test. One quiet line of identity, then the words.
     No max-width here: the typing area stretches edge-to-edge like monkeytype,
     and the whole block sits centred in the viewport so wide screens do not
     leave a dead band at the bottom. -->
<section
  class="flex min-h-[calc(100dvh-3.5rem)] w-full flex-col justify-center px-4 pt-4 pb-10 sm:px-6"
>
  <h1 class="font-bangla text-center text-lg font-medium text-muted">{copy.h1}</h1>

  <div class="mt-8">
    <Practice client:load lang={lang} seed={1} />
  </div>
</section>
