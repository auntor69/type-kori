---
import Practice from "./Practice.tsx";
import { homeCopy } from "../content/home";
import { localizePath, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = homeCopy[lang];
---

<!-- Hero: wordmark, one line, straight into the practice area. -->
<section class="mx-auto w-full max-w-[720px] px-4 pt-20 pb-4 sm:px-6 sm:pt-28">
  <h1 class="text-center">
    <span class="block text-sm font-medium tracking-[0.2em] uppercase text-muted">
      Type Kori
    </span>
    <span class="font-bangla mt-4 block text-6xl leading-[1.15] font-semibold text-text sm:text-7xl">
      {copy.h1}
    </span>
  </h1>

  <p class="font-bangla mx-auto mt-5 max-w-md text-center text-base text-muted">
    {copy.lead}
  </p>

  <p class="mt-14 text-center text-xs text-muted">{copy.tagline}</p>
</section>

<!-- Practice: the whole page exists for this. -->
<section id="practice" class="mx-auto w-full max-w-[960px] scroll-mt-20 px-4 py-4 sm:px-6">
  <Practice client:load lang={lang} seed={1} />
  <p class="mt-3 text-center text-xs text-muted">{copy.footnote}</p>
</section>

<!-- Features: five titles with one line each, no cards. -->
<section class="mx-auto w-full max-w-[720px] px-4 py-16 sm:px-6">
  <h2 class="text-xs font-semibold tracking-[0.18em] uppercase text-muted">
    {copy.featuresTitle}
  </h2>

  <dl class="mt-6 grid gap-x-10 gap-y-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      copy.features.map((feature) => (
        <div>
          <dt class="font-bangla text-sm font-semibold text-text">{feature.title}</dt>
          <dd class="font-bangla mt-1 text-sm text-muted">{feature.line}</dd>
        </div>
      ))
    }
  </dl>
</section>

<!-- How it works: three numbered words, no borders, no backgrounds. -->
<section id="how" class="mx-auto w-full max-w-[720px] scroll-mt-20 px-4 pb-16 sm:px-6">
  <h2 class="text-xs font-semibold tracking-[0.18em] uppercase text-muted">{copy.howTitle}</h2>

  <ol class="mt-6 grid gap-6 sm:grid-cols-3">
    {
      copy.how.map((step, index) => (
        <li>
          <span class="text-sm font-semibold tabular-nums text-accent">{index + 1}</span>
          <span class="font-bangla ms-3 text-sm font-semibold text-text">{step.title}</span>
          <p class="font-bangla mt-1 text-sm text-muted">{step.line}</p>
        </li>
      ))
    }
  </ol>
</section>

<!-- FAQ: a plain definition list. -->
<section id="faq" class="mx-auto w-full max-w-[720px] scroll-mt-20 px-4 pb-16 sm:px-6">
  <h2 class="text-xs font-semibold tracking-[0.18em] uppercase text-muted">{copy.faqTitle}</h2>

  <dl class="mt-6 grid gap-x-10 gap-y-6 sm:grid-cols-2">
    {
      copy.faq.map((item) => (
        <div>
          <dt class="font-bangla text-sm font-semibold text-text">{item.question}</dt>
          <dd class="font-bangla mt-1 text-sm text-muted">{item.answer}</dd>
        </div>
      ))
    }
  </dl>
</section>

<!-- Closing: a quiet pointer back to the typing area, plus lessons. -->
<section class="mx-auto w-full max-w-[720px] px-4 pb-24 sm:px-6">
  <h2 class="font-bangla text-2xl font-semibold text-text">{copy.closingTitle}</h2>

  <div class="mt-5 flex flex-wrap items-center gap-6">
    <a
      href="#practice"
      class="rounded-control bg-accent px-5 py-2.5 text-sm font-semibold text-on-accent transition-opacity duration-150 ease-out hover:opacity-90"
    >
      {copy.primaryCta}
    </a>
    <a
      href={localizePath("/lessons", lang)}
      class="text-sm font-medium text-muted underline-offset-4 transition-colors duration-150 ease-out hover:text-text hover:underline"
    >
      {copy.lessonsCta}
    </a>
  </div>

  <p class="font-bangla mt-4 text-sm text-muted">{copy.closingCta}</p>
</section>
