---
import type { Lang } from "../i18n";

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description: string;
  crumbs: Crumb[];
  /** Small heading key for the "see also" links at the bottom. */
  lang: Lang;
  reviewNote?: string;
}

const { title, description, crumbs, reviewNote } = Astro.props;
---

<article class="mx-auto w-full max-w-[820px] px-4 py-12 sm:px-6">
  <nav aria-label="Breadcrumb" class="text-xs text-muted">
    <ol class="flex flex-wrap items-center gap-2">
      {
        crumbs.map((crumb, index) => (
          <li class="flex items-center gap-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {crumb.href === undefined ? (
              <span aria-current="page">{crumb.label}</span>
            ) : (
              <a href={crumb.href} class="transition-colors duration-150 ease-out hover:text-text">
                {crumb.label}
              </a>
            )}
          </li>
        ))
      }
    </ol>
  </nav>

  <h1 class="mt-6 text-3xl font-semibold leading-tight text-text">{title}</h1>
  <p class="mt-3 max-w-2xl text-base leading-relaxed text-muted">{description}</p>

  <div class="mt-8 space-y-8">
    <slot />
  </div>

  {
    reviewNote !== undefined && (
      <p class="mt-10 rounded-card border border-border bg-surface p-3 text-xs leading-relaxed text-muted">
        {reviewNote}
      </p>
    )
  }
</article>

<slot name="schema" />
