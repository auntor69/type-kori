  "behavior": {
    "autoHasanta": {
      "enabled": true,
      "source": "reference",
      "nativeReviewed": false,
      "note": "Two consonant letters written next to each other are meant to join: the hasanta between them is inserted for the typist, which is how `khondo` gives খন্ড and `srasto` gives স্রস্ট. This only ever fires when the typist writes no vowel between the two consonants, so the inherent vowel is spelled with `o` (see the `o` row) and never triggers it."
    },
    "digitsAreBengali": {
      "enabled": true,
      "source": "masterplan",
      "nativeReviewed": false,
      "note": "Section 7.3.5: the engine's digit output is configurable and Avro Phonetic produces Bengali digits."
    }
