---
import "../styles/global.css";

import SiteHeader from "../components/SiteHeader.astro";
import { STORAGE_PREFIX } from "../lib/settings";
import { localizePath, useTranslations, type Lang } from "../i18n";

import bengaliFont from "@fontsource-variable/noto-sans-bengali/files/noto-sans-bengali-bengali-wght-normal.woff2?url";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Site-root-relative path of this page, used for the canonical URL. */
  path: string;
}

const { lang, title, description, path } = Astro.props;
const t = useTranslations(lang);

const absolute = (sitePath: string) => new URL(sitePath, Astro.site).href;
const canonical = absolute(localizePath(path, lang));
const banglaUrl = absolute(localizePath(path, "bn"));
const englishUrl = absolute(localizePath(path, "en"));

// Resolves the stored theme and text size before the first paint, so there is no
// flash of the wrong theme. Kept inline and dependency-free on purpose; it
// mirrors applySettings for the concrete-theme case.
const themeBootstrap = `(function(){
  try{
    var s=JSON.parse(localStorage.getItem("${STORAGE_PREFIX}settings")||"{}");
    var r=document.documentElement;
    var f=Number(s.fontSize);
    if(isFinite(f)&&f>0){var z=Math.min(48,Math.max(20,Math.round(f)));r.style.setProperty("--typing-size",z+"px");}
    var t=s.theme;
    var applied=false;
    if(t&&t!=="system"){
      var p=localStorage.getItem("${STORAGE_PREFIX}theme:"+t);
      if(p){
        try{
          var v=JSON.parse(p);
          for(var k in v){if(k.charAt(0)!=="_")r.style.setProperty(k,v[k]);}
          r.setAttribute("data-theme",v["__dark"]?"dark":"light");
          r.style.colorScheme=v["__dark"]?"dark":"light";
          applied=true;
        }catch(e){}
      }
    }
    if(!applied){
      var d=window.matchMedia("(prefers-color-scheme: dark)").matches;
      r.setAttribute("data-theme",d?"dark":"light");
    }
  }catch(e){}
})();`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="alternate" hreflang="bn" href={banglaUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="x-default" href={banglaUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Type Kori" />
    <meta property="og:locale" content={lang === "bn" ? "bn_BD" : "en_US"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#2c2e31" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={bengaliFont} />

    <script is:inline set:html={themeBootstrap} />
  </head>

  <body class="min-h-dvh antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-control focus:bg-accent focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-on-accent"
    >
      {t("nav.skipToContent")}
    </a>

    <SiteHeader lang={lang} />

    <main id="main">
      <slot />
    </main>

    <!--
      Offline support: register the service worker in production builds only.
      The dev server transforms modules on the fly, so caching them would
      serve stale code after every edit — the worker stays out of development.
    -->
    <script>
      if (import.meta.env.PROD && "serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {
            // Offline support is a bonus: a failed registration changes nothing.
          });
        });
      }
    </script>
  </body>
</html>
