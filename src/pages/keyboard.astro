---
import Prose from "../components/Prose.astro";
import { transliterate } from "../engine/input/phonetic";
import { localizePath, useTranslations } from "../i18n";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  guideRowMatchesEngine,
  phoneticGuideGroups,
  phoneticGuideTotals,
} from "../lib/phoneticGuide";

const lang = "bn" as const;
const t = useTranslations(lang);
const absolute = (path: string) => new URL(localizePath(path, lang), Astro.site).href;

/**
 * The tables come from the grammar itself (`src/engine/input/phonetic-rules.json`),
 * so this page can never drift from the engine: correcting a rule corrects the
 * sheet in the same commit. `guideRowMatchesEngine` re-runs each row through the
 * real engine, and a row that disagrees is marked instead of printed as fact.
 */
const groups = phoneticGuideGroups();
const totals = phoneticGuideTotals(groups);
const howKeys = ["context", "hasanta", "backspace", "dictionary", "digits"] as const;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: t("nav.home"), item: absolute("/") },
    { "@type": "ListItem", position: 2, name: t("nav.keyboard"), item: absolute("/keyboard") },
  ],
};

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: t("keyboard.title"),
  description: t("keyboard.description"),
  inLanguage: "bn-BD",
  url: absolute("/keyboard"),
  isAccessibleForFree: true,
  breadcrumb: breadcrumbSchema,
};
---

<BaseLayout
  lang={lang}
  title={t("keyboard.meta.title")}
  description={t("keyboard.meta.description")}
  path="/keyboard"
>
  <Prose
    lang={lang}
    title={t("keyboard.title")}
    description={t("keyboard.description")}
    reviewNote={t("content.reviewNote")}
    crumbs={[
      { label: t("nav.home"), href: localizePath("/", lang) },
      { label: t("nav.keyboard") },
    ]}
  >
    <section>
      <h2 class="text-xl font-semibold text-text">{t("keyboard.how.title")}</h2>
      <ul class="mt-4 space-y-3">
        {
          howKeys.map((key) => (
            <li class="flex gap-2 text-base leading-relaxed text-muted">
              <span class="mt-2 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
              <span>{t(`keyboard.how.${key}`)}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <h2 class="text-xl font-semibold text-text">{t("keyboard.sheet.title")}</h2>
      <p class="mt-2 text-sm text-muted">
        {totals.rows} {t("keyboard.rows")} · {totals.reviewed}
        {" "}{t("keyboard.status.reviewed")} · {totals.pending}
        {" "}{t("keyboard.status.pending")}
      </p>

      {
        groups.map((group) => (
          <div class="mt-6">
            <h3 class="text-lg font-semibold text-text">
              {t(`keyboard.group.${group.id}`)}
              <span class="ms-2 text-xs font-normal text-muted">
                {group.rows.length} {t("keyboard.rows")}
              </span>
            </h3>

            <div class="mt-3 overflow-x-auto rounded-card border border-border">
              <table class="w-full border-collapse text-sm">
                <caption class="sr-only">{t(`keyboard.group.${group.id}`)}</caption>
                <thead>
                  <tr class="bg-surface-2">
                    <th
                      scope="col"
                      class="border-b border-border px-4 py-2 text-start text-xs font-medium text-muted"
                    >
                      {t("keyboard.column.latin")}
                    </th>
                    <th
                      scope="col"
                      class="border-b border-border px-4 py-2 text-start text-xs font-medium text-muted"
                    >
                      {t("keyboard.column.result")}
                    </th>
                    {group.id === "vowels" && (
                      <th
                        scope="col"
                        class="border-b border-border px-4 py-2 text-start text-xs font-medium text-muted"
                      >
                        {t("keyboard.column.sign")}
                      </th>
                    )}
                  </tr>
                </thead>
                <tbody>
                  {group.rows.map((row) => (
                    <tr>
                      <td class="border-b border-border px-4 py-1.5">
                        <kbd class="keycap font-mono">{row.latin}</kbd>
                      </td>
                      <td class="border-b border-border px-4 py-1.5">
                        <span lang="bn" class="font-bangla text-base text-text">
                          {row.bangla}
                        </span>
                        {!guideRowMatchesEngine(row, transliterate) && (
                          <span class="ms-2 text-xs text-muted">{t("keyboard.mismatch")}</span>
                        )}
                      </td>
                      {group.id === "vowels" && (
                        <td class="border-b border-border px-4 py-1.5">
                          <span lang="bn" class="font-bangla text-base text-muted">
                            {row.sign ?? "—"}
                          </span>
                        </td>
                      )}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        ))
      }
    </section>

    <section>
      <h2 class="text-lg font-semibold text-text">{t("keyboard.related")}</h2>
      <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm">
        <a href={localizePath("/", lang)} class="text-accent hover:opacity-80">
          {t("keyboard.practice")}
        </a>
        <a href={localizePath("/guides", lang)} class="text-accent hover:opacity-80">
          {t("nav.guides")}
        </a>
        <a href={localizePath("/faq", lang)} class="text-accent hover:opacity-80">
          {t("nav.faq")}
        </a>
      </p>
      <p class="mt-3 text-sm leading-relaxed text-muted">{t("keyboard.note")}</p>
    </section>
  </Prose>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
</BaseLayout>
