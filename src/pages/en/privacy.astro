---
import { privacyCopy } from "../../content/privacy";
import { localizePath, useTranslations } from "../../i18n";
import BaseLayout from "../../layouts/BaseLayout.astro";

const lang = "en" as const;
const copy = privacyCopy[lang];
const t = useTranslations(lang);

const absolute = (path: string) => new URL(localizePath(path, lang), Astro.site).href;

// The page sits one level under the home page, so the trail is short. Stating
// it lets a search engine show the same path the breadcrumb nav shows.
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: t("nav.home"), item: absolute("/") },
    { "@type": "ListItem", position: 2, name: copy.title.split("|")[0].trim(), item: absolute("/privacy") },
  ],
};
---

<BaseLayout lang={lang} title={copy.title} description={copy.description} path="/privacy">
  <article class="mx-auto w-full max-w-[720px] px-4 py-14 sm:px-6">
    <h1 class="text-3xl font-semibold text-text">{copy.title.split("|")[0]}</h1>
    <p class="mt-4 text-base leading-relaxed text-muted">{copy.intro}</p>

    <div class="mt-10 grid gap-4">
      {
        copy.sections.map((section) => (
          <section class="rounded-card border border-border bg-surface p-5">
            <h2 class="text-base font-semibold text-text">{section.title}</h2>
            <p class="mt-2 text-sm leading-relaxed text-muted">{section.body}</p>
          </section>
        ))
      }
    </div>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</BaseLayout>
