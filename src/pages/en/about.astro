---
import Prose from "../../components/Prose.astro";
import { aboutCopy } from "../../content/faq";
import { localizePath, useTranslations } from "../../i18n";
import BaseLayout from "../../layouts/BaseLayout.astro";

const lang = "en" as const;
const t = useTranslations(lang);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: t("nav.home"),
      item: new URL(localizePath("/", lang), Astro.site).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: t("nav.about"),
      item: new URL(localizePath("/about", lang), Astro.site).href,
    },
  ],
};
---

<BaseLayout
  lang={lang}
  title={t("about.meta.title")}
  description={t("about.meta.description")}
  path="/about"
>
  <Prose
    lang={lang}
    title={aboutCopy.title[lang]}
    description={aboutCopy.lead[lang]}
    crumbs={[{ label: t("nav.home"), href: localizePath("/", lang) }, { label: t("nav.about") }]}
  >
    {
      aboutCopy.paragraphs.map((paragraph) => (
        <p class="text-base leading-relaxed text-muted">{paragraph[lang]}</p>
      ))
    }

    <p class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
      <a href={localizePath("/", lang)} class="text-accent hover:opacity-80">{t("nav.practice")}</a>
      <a href={localizePath("/guides", lang)} class="text-accent hover:opacity-80">{t("nav.guides")}</a>
      <a href={localizePath("/faq", lang)} class="text-accent hover:opacity-80">{t("nav.faq")}</a>
      <a href={localizePath("/privacy", lang)} class="text-accent hover:opacity-80">{t("nav.privacy")}</a>
    </p>
  </Prose>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</BaseLayout>
