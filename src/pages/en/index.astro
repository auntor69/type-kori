---
import HomeBody from "../../components/HomeBody.astro";
import { useTranslations } from "../../i18n";
import BaseLayout from "../../layouts/BaseLayout.astro";

const lang = "en" as const;
const t = useTranslations(lang);

const appSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Type Kori",
  alternateName: "টাইপ করি",
  applicationCategory: "EducationalApplication",
  operatingSystem: "Any",
  browserRequirements: "Requires JavaScript",
  inLanguage: ["bn", "en"],
  isAccessibleForFree: true,
  description: t("meta.description"),
  image: new URL("/og.png", Astro.site).href,
  author: { "@type": "Organization", name: "Afterclass Studio", url: Astro.site?.href },
  publisher: { "@type": "Organization", name: "Afterclass Studio" },
  offers: { "@type": "Offer", price: "0", priceCurrency: "BDT" },
};
---

<BaseLayout lang={lang} title={t("meta.title")} description={t("meta.description")} path="/">
  <HomeBody lang={lang} />

  <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
</BaseLayout>
